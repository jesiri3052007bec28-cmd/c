#include <string.h>
#include <stdbool.h>

int wordBreak(char* s, char** wordDict, int wordDictSize) {
    int len = strlen(s);
    
    bool dp[301] = {false};
    dp[0] = true; 

    for (int i = 1; i <= len; i++) {
        
        int start = (i - 20 > 0) ? i - 20 : 0;
        
        for (int j = i - 1; j >= start; j--) {
            
            if (dp[j]) {
                int subLen = i - j;
                
                for (int k = 0; k < wordDictSize; k++) {
                    if (strlen(wordDict[k]) == subLen && strncmp(&s[j], wordDict[k], subLen) == 0) {
                        dp[i] = true;
                        break;
                    }
                }
                
                if (dp[i]) {
                    break;
                }
            }
        }
    }

    return dp[len];
}
