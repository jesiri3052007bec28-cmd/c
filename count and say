char* countAndSay(int n) {
    if (n <= 0) return "";
    
    char* currentStr = (char*)malloc(2 * sizeof(char));
    strcpy(currentStr, "1");
    
    for (int i = 2; i <= n; i++) {
        int len = strlen(currentStr);
        
        char* nextStr = (char*)malloc((len * 2 + 1) * sizeof(char));
        int nextLen = 0;
        int j = 0;
        
        while (j < len) {
            char currChar = currentStr[j];
            int count = 0;
            
            while (j < len && currentStr[j] == currChar) {
                count++;
                j++;
            }
            
            nextStr[nextLen++] = '0' + count;
            nextStr[nextLen++] = currChar;
        }
        nextStr[nextLen] = '\0'; 
        
        free(currentStr);
        currentStr = nextStr;
    }
    
    return currentStr;
}

