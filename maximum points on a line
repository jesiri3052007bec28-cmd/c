#include <stdio.h>
#include <stdlib.h>
#include <math.h>
int gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

int maxPoints(int** points, int pointsSize, int* pointsColSize) {
    if (pointsSize <= 2) {
        return pointsSize;
    }

    int maxPointsOnLine = 0;

    for (int i = 0; i < pointsSize; i++) {
        int currentMax = 0;
        
        for (int j = i + 1; j < pointsSize; j++) {
            int count = 1; 
            int dx1 = points[j][0] - points[i][0];
            int dy1 = points[j][1] - points[i][1];

            int g1 = gcd(dx1, dy1);
            dx1 /= g1;
            dy1 /= g1;
            
            if (dx1 < 0 || (dx1 == 0 && dy1 < 0)) {
                dx1 = -dx1;
                dy1 = -dy1;
            }

            for (int k = j; k < pointsSize; k++) {
                int dx2 = points[k][0] - points[i][0];
                int dy2 = points[k][1] - points[i][1];
                
                int g2 = gcd(dx2, dy2);
                dx2 /= g2;
                dy2 /= g2;

                if (dx2 < 0 || (dx2 == 0 && dy2 < 0)) {
                    dx2 = -dx2;
                    dy2 = -dy2;
                }

                if (dx1 == dx2 && dy1 == dy2) {
                    count++;
                }
            }
            if (count > currentMax) {
                currentMax = count;
            }
        }
        
        if (currentMax > maxPointsOnLine) {
            maxPointsOnLine = currentMax;
        }
    }

    return maxPointsOnLine;
}
