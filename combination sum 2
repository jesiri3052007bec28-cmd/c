#include <stdlib.h>

int** result;
int resSize;
int resCapacity;
int* columnSizes;


int compare(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

void backtrack(int* candidates, int candidatesSize, int target, int* currentCombination, int currentSize, int index) {
    
    if (target == 0) {
        if (resSize >= resCapacity) {
            resCapacity *= 2;
            result = (int**)realloc(result, resCapacity * sizeof(int*));
            columnSizes = (int*)realloc(columnSizes, resCapacity * sizeof(int));
        }
        

        int* copy = (int*)malloc(currentSize * sizeof(int));
        for (int i = 0; i < currentSize; i++) {
            copy[i] = currentCombination[i];
        }
        
        columnSizes[resSize] = currentSize;
        result[resSize++] = copy;
        return;
    }
    
    for (int i = index; i < candidatesSize; i++) {
        if (candidates[i] > target) {
            break;
        }
        
        if (i > index && candidates[i] == candidates[i - 1]) {
            continue;
        }
        
        currentCombination[currentSize] = candidates[i];
        
        backtrack(candidates, candidatesSize, target - candidates[i], currentCombination, currentSize + 1, i + 1);
    }
}

int** combinationSum2(int* candidates, int candidatesSize, int target, int* returnSize, int** returnColumnSizes) {
    
    qsort(candidates, candidatesSize, sizeof(int), compare);
    
    resSize = 0;
    resCapacity = 100;
    result = (int**)malloc(resCapacity * sizeof(int*));
    columnSizes = (int*)malloc(resCapacity * sizeof(int));
    
    int* currentCombination = (int*)malloc(target * sizeof(int));
    
    backtrack(candidates, candidatesSize, target, currentCombination, 0, 0);
    
    free(currentCombination);
    
    *returnSize = resSize;
    *returnColumnSizes = columnSizes;
    return result;
}
