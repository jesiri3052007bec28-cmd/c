#include <stdlib.h>
typedef struct Node {
    int key;
    int value;
    struct Node* prev;
    struct Node* next;
} Node;

typedef struct {
    int capacity;
    int size;
    Node* head;
    Node* tail;
    Node* map[10001]; 
} LRUCache;

void removeNode(LRUCache* obj, Node* node) {
    if (node->prev != NULL) {
        node->prev->next = node->next;
    } else {
        obj->head = node->next;
    }
    
    if (node->next != NULL) {
        node->next->prev = node->prev;
    } else {
        obj->tail = node->prev;
    }
}

void insertAtHead(LRUCache* obj, Node* node) {
    node->next = obj->head;
    node->prev = NULL;
    
    if (obj->head != NULL) {
        obj->head->prev = node;
    }
    obj->head = node;
    
    if (obj->tail == NULL) {
        obj->tail = node;
    }
}


LRUCache* lRUCacheCreate(int capacity) {
    LRUCache* cache = (LRUCache*)malloc(sizeof(LRUCache));
    cache->capacity = capacity;
    cache->size = 0;
    cache->head = NULL;
    cache->tail = NULL;
    
    
    for (int i = 0; i <= 10000; i++) {
        cache->map[i] = NULL;
    }
    return cache;
}

int lRUCacheGet(LRUCache* obj, int key) {
    if (obj->map[key] == NULL) {
        return -1;
    }
    
    Node* node = obj->map[key];
    
    removeNode(obj, node);
    insertAtHead(obj, node);
    
    return node->value;
}

void lRUCachePut(LRUCache* obj, int key, int value) {
    if (obj->map[key] != NULL) {
        
        Node* node = obj->map[key];
        node->value = value;
        removeNode(obj, node);
        insertAtHead(obj, node);
    } else {
        
        Node* newNode = (Node*)malloc(sizeof(Node));
        newNode->key = key;
        newNode->value = value;
        newNode->prev = NULL;
        newNode->next = NULL;
        
        if (obj->size >= obj->capacity) {
            
            Node* lruNode = obj->tail;
            obj->map[lruNode->key] = NULL;
            removeNode(obj, lruNode);
            free(lruNode);
            obj->size--;
        }
        
        insertAtHead(obj, newNode);
        obj->map[key] = newNode;
        obj->size++;
    }
}

void lRUCacheFree(LRUCache* obj) {
    Node* current = obj->head;
    while (current != NULL) {
        Node* nextNode = current->next;
        free(current);
        current = nextNode;
    }
    free(obj);
}
