struct TreeNode* helper(int* preorder, int* preorderIdx, int* inorder, int inStart, int inEnd) {
    if (inStart > inEnd) return NULL;
    int rootVal = preorder[*preorderIdx];
    struct TreeNode* root = (struct TreeNode*)malloc(sizeof(struct TreeNode));
    root->val = rootVal;
    (*preorderIdx)++;
    int mid = inStart;
    while (inorder[mid] != rootVal) {
        mid++;
    }
    root->left = helper(preorder, preorderIdx, inorder, inStart, mid - 1);
    root->right = helper(preorder, preorderIdx, inorder, mid + 1, inEnd);

    return root;
}

struct TreeNode* buildTree(int* preorder, int preorderSize, int* inorder, int inorderSize) {
    int preorderIdx = 0;
    return helper(preorder, &preorderIdx, inorder, 0, inorderSize - 1);
}
